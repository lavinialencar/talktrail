<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.talktrail.server</string>
  <key>ProgramArguments</key>
  <array>
    <string>/usr/bin/python3</string>
    <string>__PASTA_DO_PROJETO__/server/talktrail_server.py</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>TALKTRAIL_OUT</key>
    <string>__PASTA_DAS_REUNIOES__</string>
  </dict>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>StandardErrorPath</key>
  <string>/tmp/talktrail.err</string>
  <key>StandardOutPath</key>
  <string>/tmp/talktrail.out</string>
</dict>
</plist>
